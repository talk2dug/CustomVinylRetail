{
  "name": "print-station",
  "version": "1.1.2",
  "description": "Desktop print station for managing vinyl sticker production orders.",
  "main": "src/main.js",
  "private": true,
  "author": "Swayze Custom Vinyl",
  "license": "MIT",
  "scripts": {
    "start": "electronmon .",
    "dev": "electronmon .",
    "app": "electron .",
    "build:win": "electron-builder --win",
    "build": "electron-builder",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^9.6.0",
    "chokidar": "^3.6.0",
    "dotenv": "^17.2.3",
    "electron-store": "^9.0.0",
    "electron-updater": "^6.6.2",
    "form-data": "^4.0.0",
    "node-fetch": "^3.3.2",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.0",
    "three": "^0.152.0",
    "unzipper": "^0.12.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electronmon": "^2.0.3"
  },
  "build": {
    "appId": "com.swayze.printstation",
    "productName": "Vinyl Print Station",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "asar": true,
    "publish": {
      "provider": "generic",
      "url": "https://blueridgecustomco.com/updates/print-station",
      "channel": "latest"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "publisherName": "Swayze Custom Vinyl"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
